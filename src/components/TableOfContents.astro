---
interface TocItem {
  num: string;
  label: string;
  href?: string;
}

interface Props {
  items: TocItem[];
  collapsible?: boolean;
  title?: string;
}

const { items, collapsible = false, title = 'Op deze pagina' } = Astro.props;
---
{collapsible ? (
  <details class="rv-toc-collapsible">
    <summary class="rv-label">{title} · {items.length} secties</summary>
    <ol class="rv-toc-list" data-toc>
      {items.map((it) => (
        <li>
          <a href={it.href || `#s${it.num}`}>
            <span class="rv-toc-dot" aria-hidden="true"></span>
            <span class="rv-toc-num">{it.num}</span>
            <span>{it.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </details>
) : (
  <nav class="rv-toc" aria-label={title} data-toc-nav>
    <div class="rv-label rv-toc-head">{title}</div>
    <ol class="rv-toc-list" data-toc>
      {items.map((it) => (
        <li>
          <a href={it.href || `#s${it.num}`}>
            <span class="rv-toc-dot" aria-hidden="true"></span>
            <span class="rv-toc-num">{it.num}</span>
            <span>{it.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((list) => {
    const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));
    const entries = links
      .map((a) => ({ link: a, target: document.querySelector<HTMLElement>(a.getAttribute('href') || '') }))
      .filter((e): e is { link: HTMLAnchorElement; target: HTMLElement } => !!e.target);
    if (!entries.length) return;

    const observer = new IntersectionObserver(
      (observed) => {
        for (const entry of observed) {
          if (!entry.isIntersecting) continue;
          const active = entries.find((e) => e.target === entry.target);
          if (!active) continue;
          entries.forEach((e) => e.link.removeAttribute('aria-current'));
          active.link.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-96px 0px -60% 0px' }
    );
    entries.forEach((e) => observer.observe(e.target));
  });
</script>
