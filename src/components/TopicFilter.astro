---
interface FilterTopic {
  id: string;
  label: string;
}

interface Props {
  topics?: FilterTopic[];
  'aria-label'?: string;
}

const { topics = [{ id: 'all', label: 'Alles' }], 'aria-label': ariaLabel = 'Filter op onderwerp' } = Astro.props;
---
<div class="rv-filter" role="tablist" aria-label={ariaLabel} data-topic-filter>
  {topics.map((t, i) => (
    <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-topic-id={t.id}>{t.label}</button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-topic-filter]').forEach((filter) => {
    const list = filter.parentElement?.querySelector<HTMLElement>('[data-post-list]');
    if (!list) return;
    filter.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-topic-id]');
      if (!button) return;
      filter.querySelectorAll('button').forEach((b) => b.setAttribute('aria-selected', String(b === button)));
      const topicId = button.dataset.topicId;
      list.querySelectorAll<HTMLElement>('[data-topic]').forEach((item) => {
        item.hidden = topicId !== 'all' && item.dataset.topic !== topicId;
      });
    });
  });
</script>
