---
interface Props {
  restX?: string;
  restY?: string;
  restDot?: boolean;
  interactive?: boolean;
  class?: string;
  'aria-label'?: string;
}

const { restX = '75%', restY = '45%', restDot = true, interactive = true, class: className, 'aria-label': ariaLabel } = Astro.props;
---
<section class:list={['rv-dotgrid', className]} aria-label={ariaLabel} data-dotgrid={interactive ? 'interactive' : undefined}>
  <div class="rv-dotgrid-dots" aria-hidden="true" style={`--rv-mx: ${restX}; --rv-my: ${restY};`}></div>
  {restDot && <div class="rv-dotgrid-snap" aria-hidden="true" style={`left: calc(${restX} - 3px); top: calc(${restY} - 3px);`}></div>}
  <div class="rv-dotgrid-content">
    <slot />
  </div>
</section>
