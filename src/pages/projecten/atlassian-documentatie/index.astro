---
import Layout from '../../../layouts/Layout.astro';
import DataTable from '../../../components/DataTable.astro';
import MetaLine from '../../../components/MetaLine.astro';
import documentation from '../../../../data/atlassian-documentation.json';

const columns = [
  { header: 'Link', field: 'title', link: 'url' },
  { header: 'Product', field: 'product', mono: true },
  { header: 'Hosting', field: 'hosting', mono: true },
  { header: 'Beschrijving', field: 'description' },
];
---
<Layout title="Atlassian documentatie — Rik de Valk" description="Verzamelde links naar Atlassian product-documentatie.">
  <div class="rv-frame rv-layout-wide">
    <div style="display: flex; flex-direction: column; gap: var(--space-4); max-width: var(--measure-text); margin-bottom: var(--space-8);">
      <a class="rv-plain rv-label" href="/projecten/"><span class="rv-ttl">Projecten</span> /</a>
      <h1 style="margin: 0; font-size: 48px; line-height: 52px; font-weight: 600; letter-spacing: -0.02em;">Atlassian documentatie</h1>
      <p style="margin: 0; font-size: 20px; line-height: 32px; color: var(--ink-muted);">Verzamelde links naar Atlassian product-documentatie.</p>
      <MetaLine items={[`${documentation.items.length} links`]} />
    </div>
    <DataTable columns={columns} items={documentation.items} searchable />
  </div>
</Layout>
