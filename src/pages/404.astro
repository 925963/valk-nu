---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pagina niet gevonden — Rik de Valk" description="Deze pagina bestaat niet (meer).">
  <div class="rv-frame rv-layout-single">
    <div class="rv-label">404</div>
    <h1 style="margin: var(--space-4) 0 0; font-size: 48px; line-height: 52px; font-weight: 600; letter-spacing: -0.02em;">Pagina niet gevonden</h1>
    <p style="margin: var(--space-4) 0 0; font-size: 20px; line-height: 32px; color: var(--ink-muted);">Deze pagina bestaat niet, of niet meer.</p>
    <div style="display: flex; gap: var(--space-8); padding-top: var(--space-8); font-size: 15px; line-height: 24px;">
      <a class="rv-link" href="/">Naar de homepage</a>
      <a class="rv-link" href="/archief/">Naar het archief</a>
    </div>
  </div>
</Layout>
