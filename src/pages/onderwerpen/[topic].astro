---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { TOPICS } from '../../config/topics';
import { getReadingMinutes, formatDateISO, isPublished } from '../../lib/content';

export async function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => p.data.topic === topic.id && isPublished(p))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const otherTopics = TOPICS.filter((t) => t.id !== topic.id).map((t) => ({
  ...t,
  count: allPosts.filter((p) => p.data.topic === t.id && isPublished(p)).length,
}));
---
<Layout title={`${topic.label} — Rik de Valk`} description={topic.description}>
  <div class="rv-frame rv-layout">
    <div style="display: flex; flex-direction: column; gap: var(--space-12);">
      <div style="display: flex; flex-direction: column; gap: var(--space-4);">
        <a class="rv-plain rv-label" href="/onderwerpen/"><span class="rv-ttl">Onderwerpen</span> /</a>
        <h1 style="margin: 0; font-size: 48px; line-height: 52px; font-weight: 600; letter-spacing: -0.02em;">{topic.label}</h1>
        <p style="margin: 0; font-size: 20px; line-height: 32px; color: var(--ink-muted);">{topic.description}</p>
        <div class="rv-label" style="display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center;">
          <span>{posts.length} {posts.length === 1 ? 'stuk' : 'stukken'}</span>
          {posts[0] && <span>Laatste {formatDateISO(posts[0].data.date)}</span>}
          <a class="rv-link" href={`/onderwerpen/${topic.slug}/feed.xml`}>RSS voor dit onderwerp</a>
        </div>
      </div>
      <ol style="margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none;">
        {posts.map((post) => (
          <PostListItem
            href={`/${post.id}/`}
            slug={post.id}
            date={formatDateISO(post.data.date)}
            title={post.data.title}
            excerpt={post.data.description}
            minutes={getReadingMinutes(post.body ?? '')}
            en={post.data.lang === 'en'}
          />
        ))}
      </ol>
    </div>
    <aside style="display: flex; flex-direction: column; gap: var(--space-12);">
      <div style="display: flex; flex-direction: column; gap: var(--space-4);">
        <div class="rv-label" style="padding: 12px 0; border-bottom: 1px solid var(--line);">Andere onderwerpen</div>
        {otherTopics.map((t) => (
          <div style="display: flex; flex-direction: column; gap: 4px; padding-bottom: var(--space-2);">
            <a href={`/onderwerpen/${t.slug}/`} class="rv-plain" style="display: flex; justify-content: space-between; align-items: baseline;">
              <span class="rv-ttl" style="font-size: 15px; line-height: 24px; font-weight: 500; color: var(--accent);">{t.label}</span>
              <span class="rv-label">{t.count}</span>
            </a>
            <span style="font-size: 15px; line-height: 24px; color: var(--ink-muted);">{t.description}</span>
          </div>
        ))}
      </div>
      <div style="display: flex; flex-direction: column; gap: var(--space-4);">
        <div class="rv-label" style="padding: 12px 0; border-bottom: 1px solid var(--line);">Volgen</div>
        <div style="display: flex; flex-direction: column; gap: var(--space-2); font-size: 15px; line-height: 24px;">
          <a class="rv-link" href="/feed.xml">RSS-feed (alles)</a>
          <a class="rv-link" href="https://www.linkedin.com/in/rikdevalk/">LinkedIn</a>
          <a class="rv-link" href="mailto:rik@valk.nu">E-mail</a>
        </div>
      </div>
    </aside>
  </div>
</Layout>
